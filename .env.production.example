# Public domain for Caddy. Point this domain's A record to your VPS IP.
APP_DOMAIN=agent.example.com

# Model provider keys. Keep real values only in .env.production on the server.
ZAI_API_KEY=
DEEPSEEK_API_KEY=
WQ_API_KEY=
MIMO_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional model/runtime settings.
DEFAULT_MODEL_ID=zhipu-glm-4.7-flash
LLM_MAX_TOKENS=2048
WQ_CONTEXT_WINDOW_TOKENS=128000
MIMO_CONTEXT_WINDOW_TOKENS=128000
OPENCODE_TIMEOUT_MS=120000

# OpenCode runtime. OPENCODE_MODEL must use OpenCode provider/model format.
# OPENCODE_BIN=opencode
# OPENCODE_MODEL=deepseek/deepseek-chat
# OPENCODE_WORKSPACE=/app
# OPENCODE_SERVER_HOST=127.0.0.1
# OPENCODE_SERVER_PORT=4096
# OPENCODE_SERVER_URL=
# OPENCODE_START_SERVER=true
# OPENCODE_REQUEST_TIMEOUT_MS=30000
# OPENCODE_EVENT_TIMEOUT_MS=120000

# Claude Code runtime. Claude CLI may also use local auth/keychain outside Docker.
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_WORKSPACE=/app
# CLAUDE_CODE_PERMISSION_MODE=bypassPermissions
# CLAUDE_CODE_MODEL=
# CLAUDE_CODE_BARE=false

# Claude Code + DeepSeek. Select runtime "Claude Code" and model "DeepSeek V4 Pro/Flash" in the UI.
# The runtime maps DEEPSEEK_API_KEY to Anthropic-compatible auth variables internally.
# DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# CLAUDE_CODE_DEEPSEEK_OPUS_MODEL=deepseek-v4-pro[1m]
# CLAUDE_CODE_DEEPSEEK_SONNET_MODEL=deepseek-v4-pro[1m]
# CLAUDE_CODE_DEEPSEEK_HAIKU_MODEL=deepseek-v4-flash
# CLAUDE_CODE_DEEPSEEK_SUBAGENT_MODEL=deepseek-v4-flash
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1

# Claude Code + Xiaomi MiMo. Select runtime "Claude Code" and model "小米 MiMo V2.5/Pro" in the UI.
# The runtime maps MIMO_API_KEY to Anthropic-compatible auth variables internally.
# MIMO_ANTHROPIC_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
# CLAUDE_CODE_MIMO_OPUS_MODEL=mimo-v2.5-pro
# CLAUDE_CODE_MIMO_SONNET_MODEL=mimo-v2.5-pro
# CLAUDE_CODE_MIMO_HAIKU_MODEL=mimo-v2.5
# CLAUDE_CODE_MIMO_SUBAGENT_MODEL=mimo-v2.5

# Override provider endpoints only when needed.
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# WQ_BASE_URL=http://wanqing.internal/api/gateway/v1/endpoints
# WQ_MODEL=ep-cvhcjv-1776239525862887187
# MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
