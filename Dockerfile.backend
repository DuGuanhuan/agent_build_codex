FROM python:3.12-slim

ENV HOST=0.0.0.0
ENV PORT=8000
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates ripgrep \
  && rm -rf /var/lib/apt/lists/*

COPY server.py ./server.py
COPY tools ./tools
COPY public ./public

EXPOSE 8000

CMD ["python", "server.py"]
